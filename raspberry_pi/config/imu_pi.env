# Argumentos de imu_pi (deploy/c/imu_pi.c). Tras editar:  systemctl --user restart imu-pi
# --r_imu / --r_plato: posicion en metros en ejes del chasis (origen: medio del eje de las ruedas actuadas, en el piso;
# x hacia las ruedas actuadas, y izquierda, z arriba). Medidas por Caleb el 28-oct.
# --udp: copia para RViz en la laptop (ros2 launch sim_kanayama/imu_rviz.launch.py); si la laptop no esta, no pasa nada.
IMU_ARGS=--r_imu -0.115 -0.085 0.045 --r_plato -0.115 0 0.155 --udp <LAPTOP_IP>:5006
